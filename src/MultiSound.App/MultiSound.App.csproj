<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- WPF and WinForms share type names (Application, Button); keep usings explicit. -->
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>MultiSound.App</RootNamespace>
        <AssemblyName>MultiSound</AssemblyName>
        <ApplicationIcon>Assets/MultiSound.ico</ApplicationIcon>
    </PropertyGroup>
    <!-- Only for dotnet publish: the tests reference this project, and a self-contained exe cannot be referenced. -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <ItemGroup>
        <Resource Include="Assets/MultiSound.ico" />
        <None Remove="Assets/MultiSound.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Alexpivo394.ToadDesign" Version="1.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\MultiSound.Audio\MultiSound.Audio.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="MultiSound.Tests" />
    </ItemGroup>
</Project>
